rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in get(groupPath(groupId)).data.memberIds;
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40 && name.trim() == name;
    }

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId'])
        && !exists(groupPath(request.resource.data.groupId))
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerId == request.auth.uid
        && getAfter(groupPath(request.resource.data.groupId)).data.joinCode == code;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'joinCode', 'memberIds', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() == 6
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode))
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && (
          (!(request.auth.uid in resource.data.memberIds)
            && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
            && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)))
          || removesOneNonOwnerMember()
        );

      function removedMemberIds() {
        return resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet());
      }

      function removesOneNonOwnerMember() {
        return request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
          && request.resource.data.memberIds.size() == request.resource.data.memberIds.toSet().size()
          && removedMemberIds().size() == 1
          && !removedMemberIds().hasAny([resource.data.ownerId])
          && (removedMemberIds().hasOnly([request.auth.uid]) || resource.data.ownerId == request.auth.uid);
      }

      match /members/{memberId} {
        allow read: if isMember(groupId);

        allow create: if signedIn()
          && memberId == request.auth.uid
          && validName(request.resource.data.displayName)
          && request.resource.data.joinedAt == request.time
          && (
            (request.resource.data.keys().hasOnly(['displayName', 'status', 'joinedAt'])
              && request.resource.data.status == 'OWNER'
              && !exists(groupPath(groupId))
              && getAfter(groupPath(groupId)).data.ownerId == request.auth.uid)
            ||
            (request.resource.data.keys().hasOnly(['displayName', 'status', 'joinedAt', 'joinCode'])
              && request.resource.data.status == 'MEMBER'
              && request.resource.data.joinCode == get(groupPath(groupId)).data.joinCode
              && request.auth.uid in getAfter(groupPath(groupId)).data.memberIds)
          );

        allow delete: if signedIn()
          && memberId != get(groupPath(groupId)).data.ownerId
          && (memberId == request.auth.uid || get(groupPath(groupId)).data.ownerId == request.auth.uid)
          && !(memberId in getAfter(groupPath(groupId)).data.memberIds);
      }

      match /geofences/{geofenceId} {
        allow read: if isMember(groupId);

        function validGeofence(data) {
          return validName(data.name)
            && data.latitude is number
            && data.latitude >= -90 && data.latitude <= 90
            && data.longitude is number
            && data.longitude >= -180 && data.longitude <= 180
            && data.radiusMeters is number
            && data.radiusMeters >= 100 && data.radiusMeters <= 2000;
        }

        function isCreatorOrOwner() {
          return resource.data.createdBy == request.auth.uid
            || get(groupPath(groupId)).data.ownerId == request.auth.uid;
        }

        allow create: if isMember(groupId)
          && request.resource.data.keys().hasOnly(['name', 'latitude', 'longitude', 'radiusMeters', 'createdBy'])
          && validGeofence(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if isMember(groupId)
          && isCreatorOrOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'latitude', 'longitude', 'radiusMeters'])
          && validGeofence(request.resource.data);

        allow delete: if isMember(groupId)
          && isCreatorOrOwner();
      }

      match /exitEvents/{eventId} {
        allow read: if isMember(groupId);

        allow create: if isMember(groupId)
          && request.resource.data.keys().hasOnly(['memberId', 'memberName', 'geofenceId', 'geofenceName', 'occurredAt', 'type'])
          && request.resource.data.get('type', 'EXIT') in ['ENTRY', 'EXIT']
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.memberName
            == get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.displayName
          && request.resource.data.geofenceName
            == get(/databases/$(database)/documents/groups/$(groupId)/geofences/$(request.resource.data.geofenceId)).data.name
          && request.resource.data.occurredAt == request.time;
      }
    }

    match /users/{uid}/devices/{deviceId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'ios'
        && request.resource.data.updatedAt == request.time;
    }
  }
}
