rules_version = '2';

// Data layout:
//   groups/{groupId}                 name, ownerId, joinCode, memberIds, createdAt
//   groups/{groupId}/members/{uid}   displayName, status ("OWNER" | "MEMBER"), joinedAt, joinCode (members only)
//   groups/{groupId}/geofences/{id}  name, latitude, longitude, radiusMeters, createdBy
//   groups/{groupId}/exitEvents/{id} memberId, memberName, geofenceId, geofenceName, occurredAt
//   joinCodes/{code}                 groupId
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in get(groupPath(groupId)).data.memberIds;
    }

    // Same rule as the Kotlin Validation.nameError, enforced again on the server.
    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40 && name.trim() == name;
    }

    match /joinCodes/{code} {
      // Knowing the code is what lets someone join, so codes can be read one at a time but never listed.
      allow get: if signedIn();
      // Created only in the batch that creates its group. Reusing an existing code counts as an update and is denied.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId'])
        && !exists(groupPath(request.resource.data.groupId))
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerId == request.auth.uid
        && getAfter(groupPath(request.resource.data.groupId)).data.joinCode == code;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'joinCode', 'memberIds', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() == 6
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode))
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));

      // Joining: a non-member appends only their own id, in the same batch as a member document
      // that carries the correct join code (checked by the members rule below).
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && existsAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));

      match /members/{memberId} {
        allow read: if isMember(groupId);

        allow create: if signedIn()
          && memberId == request.auth.uid
          && validName(request.resource.data.displayName)
          && request.resource.data.joinedAt == request.time
          && (
            // The creator becomes owner in the batch that creates the group.
            (request.resource.data.keys().hasOnly(['displayName', 'status', 'joinedAt'])
              && request.resource.data.status == 'OWNER'
              && !exists(groupPath(groupId))
              && getAfter(groupPath(groupId)).data.ownerId == request.auth.uid)
            ||
            // Anyone else must present the group's join code.
            (request.resource.data.keys().hasOnly(['displayName', 'status', 'joinedAt', 'joinCode'])
              && request.resource.data.status == 'MEMBER'
              && request.resource.data.joinCode == get(groupPath(groupId)).data.joinCode
              && request.auth.uid in getAfter(groupPath(groupId)).data.memberIds)
          );
      }

      match /geofences/{geofenceId} {
        allow read: if isMember(groupId);

        // Same limits as the Kotlin Validation object.
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasOnly(['name', 'latitude', 'longitude', 'radiusMeters', 'createdBy'])
          && validName(request.resource.data.name)
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
          && request.resource.data.radiusMeters is number
          && request.resource.data.radiusMeters >= 100 && request.resource.data.radiusMeters <= 2000
          && request.resource.data.createdBy == request.auth.uid;

        allow delete: if isMember(groupId)
          && (resource.data.createdBy == request.auth.uid
            || get(groupPath(groupId)).data.ownerId == request.auth.uid);
      }

      match /exitEvents/{eventId} {
        allow read: if isMember(groupId);

        // A member may only report their own exit, from a geofence that exists in this group,
        // stamped with the server's time. Events can never be changed or deleted.
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasOnly(['memberId', 'memberName', 'geofenceId', 'geofenceName', 'occurredAt'])
          && request.resource.data.memberId == request.auth.uid
          && request.resource.data.memberName
            == get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.displayName
          && request.resource.data.geofenceName
            == get(/databases/$(database)/documents/groups/$(groupId)/geofences/$(request.resource.data.geofenceId)).data.name
          && request.resource.data.occurredAt == request.time;
      }
    }
  }
}
